# SellerOnData ortam değişkenleri. `.env` olarak kopyalayın. Geliştirmede hepsi isteğe bağlıdır.

# ---------- Postgres (docker-compose) ----------
SOD_POSTGRES_PORT=5434
SOD_POSTGRES_PASSWORD=sod_postgres_dev
SOD_PLATFORM_ADMIN_DB_PASSWORD=sod_platform_admin_dev
SOD_DECISHIP_ADMIN_DB_PASSWORD=sod_deciship_admin_dev
SOD_PLATFORM_DB_PASSWORD=sod_platform_dev
SOD_DECISHIP_DB_PASSWORD=sod_deciship_dev
# Sunucuda SOD_ENV=production yazın: üretim katmanı (docker-compose.prod.yml) unutulsa da postgres kurulumu, postgres-upgrade ve
# geri yüklemenin parola eşitlemesi *_dev parolasını ve eksik parolayı reddeder. Yeni araç: SOD_<ARAÇ>_ADMIN_DB_PASSWORD ve SOD_<ARAÇ>_DB_PASSWORD.
# SOD_ENV=production

# ---------- account-api: compose dışında (npm run dev) ----------
# Uygulama rolü. Süper kullanıcı değil, yalnız platform şemasında veri.
DATABASE_URL=postgresql://sod_platform:sod_platform_dev@localhost:5434/sellerondata
# Migration rolü. Uygulama bunu kullanmaz. Üretimde *_dev parolalar reddedilir: docker-compose.prod.yml.
MIGRATE_DATABASE_URL=postgresql://sod_platform_admin:sod_platform_admin_dev@localhost:5434/sellerondata?schema=platform
# Yalnız `prisma migrate dev`: migration rolünde CREATEDB yok, gölge veritabanı süper kullanıcıyla açılır.
# SHADOW_DATABASE_URL=postgresql://postgres:sod_postgres_dev@localhost:5434/sod_shadow

PORT=4100
NODE_ENV=development

# Uygulamanın dış adresi. Posta bağlantıları bununla kurulur. Üretimde zorunlu, https olmalı (yalnız localhost serbest).
APP_BASE_URL=http://localhost:8088
# Çerezli yazma isteklerinde kabul edilen Origin listesi. Üretimde zorunlu, APP_BASE_URL kökenini içermeli.
ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5180
# Tanıtım sitesinin kökenleri (liste). Site yalnız "kimim" yoklaması ve çıkış için çağırır; başka uçta geçmez.
# Üretimde zorunlu, https olmalı (yalnız localhost serbest), ALLOWED_ORIGINS ile çakışamaz. Ör. https://sellerondata.com,https://www.sellerondata.com
SITE_ORIGINS=http://localhost:8089,http://localhost:5190

# ---------- İmza anahtarı ----------
# Tek satır özel JWK (Ed25519, `kid` dolu). Üretimde zorunlu: yoksa servis başlamaz.
# Üretmek için: npm --prefix apps/account-api run keys:generate
# Geliştirmede boşsa Platform/keys/ altına otomatik üretilir.
ACCOUNT_SIGNING_KEY=
# Döndürme: eski anahtarın açık JWK'ları, JSON dizisi. JWKS bunları da yayınlar.
ACCOUNT_PREVIOUS_PUBLIC_KEYS=
# Telefon kodu özeti için biber, en az 32 karakter. Üretimde zorunlu.
# Döndürme: eskisini PREVIOUS'a yaz, yenisini buraya, servisi yeniden başlat, 72 saat (kod ömrü) sonra PREVIOUS'u sil.
ACCOUNT_CODE_PEPPER=
ACCOUNT_CODE_PEPPER_PREVIOUS=

# ---------- Mobil sürüm politikası ----------
# En düşük desteklenen mobil sürüm (x.y.z). Altındaki uygulama 426 alır ve güncelleme ekranı gösterir. Boş: denetim yok. Hesap ve DeciShip API okur.
MIN_MOBILE_VERSION=
# En son sürüm ve indirme adresi (yalnız Hesap servisi; GET /api/account/client-policy ile yayınlanır). Boş olabilir.
MOBILE_LATEST_VERSION=
MOBILE_UPDATE_URL=

# ---------- Olay dağıtıcısı ----------
# urun=adres, virgülle ayrılır. Yalnız iç ağ adresi. Compose boşsa deciship-api'ye gönderir.
# Compose dışında ör. PRODUCT_EVENT_TARGETS=deciship=http://localhost:4000/api/deciship/internal/events
PRODUCT_EVENT_TARGETS=

# ---------- Araç bildirimi (itiraz süresi hatırlatması) ----------
# Araç (DeciShip) postayı Hesap servisinin iç ucundan ister; Hesap alıcıyı ve adresi kendisi bulur. Paylaşılan anahtar.
# Compose bunu iki servise verir: Hesap'a PRODUCT_NOTIFY_SECRETS=deciship=<anahtar>, DeciShip API'ye PRODUCT_NOTIFY_SECRET=<anahtar>.
# Boşsa yerel geliştirme anahtarı kullanılır. Üretimde zorunlu, en az 32 karakter; geliştirme anahtarı reddedilir.
PRODUCT_NOTIFY_SECRET=
# Compose dışında (npm run dev; scripts/dev.ps1 kendisi yazar):
# PRODUCT_NOTIFY_SECRETS=deciship=<anahtar>   (Hesap servisi; urun=anahtar, virgülle ayrılır, her ürünün anahtarı ayrı)
# ACCOUNT_NOTIFY_URL=http://localhost:4100/api/account/internal/notify   (DeciShip API; boşsa hatırlatma kapalı)

# ---------- Araç durumu ----------
# urun=durum, virgülle ayrılır; durum off (kapalı), pilot (yalnız aboneliği açılmış firmalar) ya da public (herkese açık).
# Boş: kayıttaki durum geçerli (Platform/packages/contracts/src/products.ts). Yalnız Hesap servisi okur; değişince servis yeniden başlatılır.
# Bilinmeyen ürün ya da durum, rolü veya API'si olmayan aracı açmak servisi başlatmaz. off acil durdurmadır (en geç 10 dk içinde erişim kesilir).
# Ör. PRODUCT_LAUNCH=orderloom=pilot
PRODUCT_LAUNCH=

# ---------- Kayıt ve posta ----------
REGISTRATION_ENABLED=true
# Yeni firma kaydı: open (herkes) ya da invite (yalnız davetle; kapalı deneme, 2026-11-12). Boşsa yerelde open, üretimde invite.
# invite iken davet: npm run signup:invite -- --email <adres> --operator <ad> (Hesap servisi). Site de bu değerle derlenir.
# Ekip daveti (e-posta, telefon + kod) her iki kipte çalışır. REGISTRATION_ENABLED=false her kipte kaydı tamamen kapatır.
SIGNUP_MODE=
# E-posta doğrulaması varsayılan olarak açıktır. Yerelde kapatmak için: SOD_EMAIL_VERIFICATION=false
# Yerelde postalar SMTP yerine veritabanına düşer; okumak için POSTA.bat (SOD_DEV_MAILBOX=false ile kapanır).
# Üretimde zorunlu: yoksa servis başlamaz. Geliştirmede boşsa posta gönderilmez, MailLog ve günlüğe yazılır (docs/KURULUM.md).
SMTP_URL=
MAIL_FROM=SellerOnData <no-reply@sellerondata.com>

# ---------- Çerez ve vekil ----------
# Boşsa NODE_ENV=production iken Secure.
COOKIE_SECURE=
# sod_lang çerezinin alanı. Üretimde .sellerondata.com. Oturum çerezleri alan almaz.
COOKIE_LANG_DOMAIN=
# Önündeki güvenilen vekil sayısı. Compose kendi varsayılanıyla 1 kullanır (gateway), burada yazılırsa onu ezer.
# Compose dışında varsayılan 0. Yanlış değer tüm istemcileri tek IP sayar veya hız sınırını atlatılabilir kılar.
# TRUST_PROXY_HOPS=0

# ---------- DeciShip (docker-compose ve geliştirme) ----------
# PDF fatura ve tartı fotoğrafı okuma için. Boşsa bu iki özellik kapalı, geri kalan her şey çalışır.
ANTHROPIC_API_KEY=
# Fiyat tablosunda olmayan model en pahalı fiyattan sayılır; yeni modeli önce AI_PRICE_TABLE'a ekleyin.
CLAUDE_MODEL=claude-sonnet-5-5
# Sonuç vermeyen yapay zekâ çağrılarının aylık tavanı, aylık hakka oranla (varsayılan 1). Dolunca yeni çağrılar durur.
# AI_FAILED_BUDGET_RATIO=1
# Sistemin günlük yapay zekâ tavanı, TL (bütün firmaların toplamı; gün Europe/Istanbul, gece yarısı sıfırlanır; 2026-11-12).
# Boş = 1000. off = tavan yok (yalnız bu yazım). 0 = yeni yapay zekâ çağrısı hiç yapılmaz (acil durdurma).
# Geçersiz değer (eksi, 1e3, false…) DeciShip API açılışını durdurur. Dolunca elle giriş ve Excel çalışır, önbellek ücretsiz sürer.
# AI_DAILY_BUDGET_TRY=1000
# Geliştirmede (compose dışında): hesap servisinin açık anahtarları ve görüntü servisi.
ACCOUNT_JWKS_URL=http://localhost:4100/api/account/.well-known/jwks.json
VISION_URL=http://localhost:8001
# Örnek veri yükleme ve sıfırlama ucu. Üretimde kapalı kalır.
ENABLE_DATA_RESET=false
# Örnek veriyle deneme turu (off: başlatılamaz). Varsayılan açık.
DEMO_TOUR=on
# İmzalı dosya bağlantısı anahtarı. BASLAT.bat ilk kurulumda üretir. Üretimde zorunlu (en az 32 karakter).
FILE_TOKEN_SECRET=

# ---------- Gateway (docker-compose) ----------
GATEWAY_PORT=8088
SITE_PORT=8089
# Tanıtım sitesinin derlemede kullandığı adresler (bağlantılar ve sitemap).
SITE_BASE_URL=http://localhost:8089
# Önünde TLS sonlandıran vekil varsa onun adresi (gerçek istemci IP'si için). Boşken X-Forwarded-For okunmaz.
# Üretimde etkisiz: docker-compose.prod.yml bunu Caddy'nin sabit adresine (SOD_CADDY_IP) bağlar.
GATEWAY_REAL_IP_FROM=127.0.0.1

# ---------- TLS: Caddy (yalnız üretim katmanı; docs/KURULUM.md "Üretim açılışı") ----------
# Dışa yalnız Caddy açılır (TCP 80, 443); sertifikayı Let's Encrypt'ten kendisi alır ve yeniler. Üçü üretimde zorunlu.
# APP_BASE_URL=https://<APP_HOST>, SITE_BASE_URL=https://<SITE_HOST> olmalı; www.<SITE_HOST> köke yönlenir (üçü için DNS A kaydı).
# APP_HOST=app.sellerondata.com
# SITE_HOST=sellerondata.com
# ACME_EMAIL: Let's Encrypt hesabının e-postası. Süre dolumu postası gelmez: sertifika yenilenmezse ayakta-mi.sh'in https
# denetimi düşer (KURULUM "Ayakta mı denetimi").
# ACME_EMAIL=
# Yerel deneme: APP_HOST=app.localhost, SITE_HOST=localhost (Caddy kendi sertifikasını verir) ve başka port.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
# Caddy'nin iç ağı ve sabit adresi. Sunucudaki başka Docker ağıyla çakışırsa ikisi birlikte değiştirilir.
# SOD_EDGE_SUBNET=172.31.250.0/24
# SOD_CADDY_IP=172.31.250.10
# CADDY_MEM=256m

# ---------- Merkez arayüzü (derlemede gömülür, değişince hub-web yeniden derlenir) ----------
# Ekip ekranındaki Android kurulum dosyası bağlantısı. Boşsa "bağlantı henüz tanımlı değil" yazar, indirme düğmesi çıkmaz.
VITE_ANDROID_APK_URL=

# ---------- Yalnız geliştirme portları (docker-compose.prod.yml hepsini kapatır) ----------
# ACCOUNT_API_PORT=4100
# VISION_PORT=8001

# ---------- Yedek (YEDEKLE.bat, scripts/yedekle.ps1; docs/KURULUM.md "Yedek ve geri yükleme") ----------
# Bilgisayar dışı şifreli kopyanın klasörü: bulut klasörü ya da harici disk (ör. D:\SellerOnData-yedek). Boşsa yalnız yerel yedek, uyarıyla.
SOD_BACKUP_OFFSITE_DIR=
# Şifreli kopyanın parolası. Boşsa ilk dış kopyada üretilip buraya yazılır. Parola yöneticisine kaydedin (YEDEKLE.bat -ParolaGoster).
SOD_BACKUP_PASSWORD=
# Yerel yedek klasörü (göreli yol Platform'a göre) ve saklama: son N yedek + son N gün + son N ayın her birinin son yedeği.
# SOD_BACKUP_DIR=yedekler
# SOD_BACKUP_KEEP_LAST=14
# SOD_BACKUP_KEEP_DAYS=14
# SOD_BACKUP_KEEP_MONTHS=12

# ---------- Sunucu: ilk kurulum ve güncelleme (scripts/kurulum.sh, scripts/guncelle.sh; docs/KURULUM.md) ----------
# Sunucunun .env'ini `bash scripts/kurulum.sh ac` üretir (rastgele parolalar ve anahtarlar, alan adları, kayıt yalnız davetle).
# guncelle.sh ayarlarını ortamdan okur (SOD_UPDATE_*, SOD_CHECK_URL), .env'den değil; yalnız SOD_BACKUP_DIR yukarıdaki gibi.
# Güncelleme öncesi yedekler <SOD_BACKUP_DIR>/guncelle/<tarih-saat>/ altında; son SOD_UPDATE_BACKUP_KEEP (3) tanesi kalır.

# ---------- Yan yana ikinci sistem ----------
# Hacim adları proje adından bağımsızdır. İkinci sistem kendi adlarını vermezse aynı veriyi paylaşır, `down -v` onu da siler.
# SOD_PGDATA_VOLUME=sod_pgdata
# SOD_STORAGE_VOLUME=sod_deciship_storage
# SOD_KEYS_DIR=./keys

# ---------- İnce ayar: compose geçirir, varsayılanlar yeterlidir ----------
# Veritabanı havuzu ve süreleri (DeciShip). Havuz dolunca kullanıcı 503 görür.
# DB_POOL_MAX=20
# DB_CONNECT_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=60000
# Firma başına aynı anda Merkez isteği, aşılırsa 429.
# HUB_CONCURRENCY_PER_ORG=6
# Arka plan iş kuyruğu (PDF okuma, toplu yeniden hesap). on: bu kap iş alır; off: almaz (ayrı çalışan kabı için).
# JOB_RUNNER=on
# Sunucu başına aynı anda yapay zekâ işi ve toplu yeniden hesap işi; ölçüm sonrası karşılaştırma sırası.
# JOB_SLOTS_AI=2
# JOB_SLOTS_RECALC=1
# MEASURE_RECOMPARE_SLOTS=2
# Boşta yoklama, iş kirası (kalp atışı dörtte biri), deneme hakkı, kapanışta süren işe tanınan süre (ms).
# JOB_POLL_MS=2000
# JOB_LEASE_MS=60000
# JOB_MAX_ATTEMPTS=5
# JOB_SHUTDOWN_GRACE_MS=30000
# Çok sayfalı PDF fatura bu kadar sayfalık gruplarla okunur; firma başına dosya alanı, GB (0 = kapalı).
# PDF_INVOICE_PAGES_PER_CALL=5
# STORAGE_QUOTA_GB_PER_ORG=10
# Silinen fatura (satırları ve dosyasıyla) ve silinen ölçümün fotoğrafları bu kadar gün sonra kalıcı silinir; geri gelmez.
# Boş (varsayılan) ya da off = KAPALI. Canlıda ZORUNLU adım: önce npm run purge:preview, sonra kullanıcı kararı 30 yazılır.
# En az 7. İtiraz kaydı olan fatura ve itiraz kanıtı fotoğraf silinmez. Silinen faturanın kaynak dosyasının 30 günlük
# disk temizliği bu değişkenlerden bağımsızdır (eskiden beri açık).
# DELETED_INVOICE_PURGE_DAYS=30
# DELETED_MEASUREMENT_PHOTO_PURGE_DAYS=30
# Canlı tartı ve işaret okuması, dakikada: kişi başına ve firma başına (aşılınca 429; ölçüm elle sürer).
# RATE_VISION_PER_MIN_MEMBER=60
# RATE_VISION_PER_MIN_ORG=240

# ---------- İnce ayar: compose GEÇİRMEZ ----------
# Bunlar .env'e yazılırsa etkisi olmaz. Yalnız compose dışında çalışırken veya bir compose ek dosyasıyla verilir.
# Varsayılanlar kodda: Hesap apps/account-api/src/env.ts, DeciShip Deciship/apps/api/src.
#   Hesap: DISPATCHER_INTERVAL_MS, REFRESH_REUSE_GRACE_SECONDS
#   DeciShip: FX_TIMEOUT_MS, READ_CONCURRENCY_PER_ORG, HUB_SLOT_MAX_MS, HUB_EXPORT_CONCURRENCY_PER_ORG, HUB_EXPORT_IDLE_MS, HUB_EXPORT_MAX_MS
# Compose kendi değerini verir, .env ile değişmez: HOST, ACCOUNT_KEYS_DIR, STORAGE_DIR.
