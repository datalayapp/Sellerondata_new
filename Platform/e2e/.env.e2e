# Uçtan uca test yığını: kendi proje adı, hacimleri ve portları. Canlı `sellerondata` projesinden tamamen ayrıdır.
# Yalnız geliştirme değerleri içerir, gizli bilgi yoktur.
SOD_PROJECT=sod-e2e
SOD_PGDATA_VOLUME=sod_e2e_pgdata
SOD_STORAGE_VOLUME=sod_e2e_storage
SOD_TAGPRESS_STORAGE_VOLUME=sod_e2e_tagpress_storage
SOD_KEYS_DIR=./e2e/.stack/keys
SOD_ENV_FILE=e2e/.stack/.env
SOD_POSTGRES_PORT=18432
ACCOUNT_API_PORT=18100
VISION_PORT=18001
GATEWAY_PORT=18188
SITE_PORT=18189
APP_BASE_URL=http://localhost:18188
SITE_BASE_URL=http://localhost:18189
ALLOWED_ORIGINS=http://localhost:18188
SITE_ORIGINS=http://localhost:18189
ENABLE_DATA_RESET=false
# Demo tohumu DeciShip örnek faturalarını ve itirazlarını yüklemez: testler kendi verisini kurar (scripts/demo.ps1).
SOD_DEMO_DATA=0
# Uçtan uca testler şimdilik doğrulamasız eski akışla koşar; Mesaj 8 Tur 2'de doğrulamalı akışa geçecek, bu iki satır o zaman kaldırılır.
SOD_EMAIL_VERIFICATION=false
SOD_DEV_MAILBOX=false
# Uçtan uca testler tek IP'den çok hızlı istek atar; üretim gateway sınırları (30r/s, 600r/m yükleme, 30r/m kimlik) onları keserdi. Sınırlar geniş tutulur.
GATEWAY_API_RATE=300r/s
GATEWAY_API_BURST=2000
GATEWAY_UPLOAD_RATE=6000r/m
GATEWAY_UPLOAD_BURST=600
# Kimlik kovası (üretimde dakikada 30): testler her senaryoda kayıt olup giriş yapar.
GATEWAY_AUTH_RATE=6000r/m
GATEWAY_AUTH_BURST=2000
