{
  "name": "@sellerondata/account-api",
  "version": "0.1.0",
  "private": true,
  "description": "SellerOnData Hesap servisi: kimlik, oturum, firma, üyelik, yetki.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "seed": "tsx scripts/seed.ts",
    "test:cli": "node --test test/cli-entries.test.mjs",
    "outbox:requeue": "tsx scripts/outbox-requeue.ts",
    "org:announce": "tsx scripts/org-announce.ts",
    "phone:release": "tsx scripts/phone-release.ts",
    "phone:restore": "tsx scripts/phone-restore.ts",
    "org:list": "tsx scripts/org-list.ts",
    "subscription:set": "tsx scripts/subscription-set.ts",
    "product:launch": "tsx scripts/product-launch.ts",
    "org:close": "tsx scripts/org-close.ts",
    "org:reopen": "tsx scripts/org-reopen.ts",
    "members:announce": "tsx scripts/members-announce.ts",
    "signup:purge": "tsx scripts/signup-purge.ts",
    "signup:invite": "tsx scripts/signup-invite.ts",
    "keys:generate": "tsx scripts/keys.ts generate",
    "keys:rotate": "tsx scripts/keys.ts rotate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sellerondata/contracts": "file:../../packages/contracts",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "jose": "^6.2.15",
    "libphonenumber-js": "^1.13.15",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sellerondata/auth-kit": "file:../../packages/auth-kit",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "argon2": true,
    "esbuild": true,
    "prisma": true
  }
}
