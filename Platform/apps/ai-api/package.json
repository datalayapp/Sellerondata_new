{
  "name": "@sellerondata/ai-api",
  "version": "0.1.0",
  "private": true,
  "description": "SellerOnData yapay zekâ geçidi: sağlayıcı anahtar deposu, araç vekili, harcama defteri, tavanlar.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/main.js",
    "test": "vitest run",
    "ai-key": "tsx src/ai-key.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sellerondata/auth-kit": "file:../../packages/auth-kit",
    "@sellerondata/contracts": "file:../../packages/contracts",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true
  }
}
