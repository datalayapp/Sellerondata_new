{
  "name": "@sellerondata/hub-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test src/lib/*.test.mjs test/*.test.mjs",
    "check:i18n": "node ../../scripts/check-i18n.mjs --root . --locales src/locales --src src --strict",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:prod": "node e2e/prod/run.mjs",
    "screens": "playwright test --config playwright.screens.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@sellerondata/contracts": "file:../../packages/contracts",
    "@sellerondata/format": "file:../../packages/format",
    "@sellerondata/shell": "file:../../packages/shell",
    "@tanstack/react-query": "^5.105.0",
    "i18next": "^26.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "msw": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
