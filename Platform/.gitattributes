# Windows klonu (core.autocrlf=true) kaplara CRLF taşımasın: bu dosyalar Linux'ta okunur.
*.sh text eol=lf
*.sql text eol=lf
*.conf text eol=lf
*.template text eol=lf
*.yml text eol=lf
*.dockerignore text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
