{
  "name": "@sellerondata/auth-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Ürün API'leri için Fastify kimlik paketi: jeton doğrulama, izin denetimi, olay alıcısı, test jetonu üretici.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"test/**/*.db.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sellerondata/contracts": "file:../contracts",
    "jose": "^6.2.15"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
