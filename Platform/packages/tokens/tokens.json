      "radius": {
        "control": 6,
        "card": 6,
        "pill": 999
      },
      "space": {
        "sm": 6,
        "md": 10,
        "lg": 12
      },
      "touch": {
        "min": 48,
        "key": 52,
        "primary": 48,
        "row": 48
      },
      "shadow": {
        "sm": "0 0 0 rgba(0,0,0,0)",
        "md": "0 4px 12px rgba(15,26,46,0.08)",
