        "bg": "#f7f6f3",
        "surface": "{--surface}",
        "surface2": "{--surface-2}",
        "border": "#e4e2dc",
        "borderSoft": "#efede8",
        "borderStrong": "#c9c5bc",
        "borderHover": "#98a2b3",
        "text": "{--text}",
        "text2": "{--text-2}",
        "text3": "{--text-3}",
        "placeholder": "#98a2b3",
        "primary": "{--primary}",
        "primaryHover": "#1546b8",
        "primarySoft": "{--primary-soft}",
        "primaryLine": "#c3d4f7",
        "success": "#0b6b3a",
        "successBg": "#e7f4ec",
        "successLine": "#b7dfc6",
        "danger": "{--danger}",
        "dangerBg": "#fdecea",
        "dangerLine": "#f6c4bf",
        "warning": "#7a4f00",
        "warningBg": "#fdf0d5",
        "warningInk": "#5c3b00",
        "disabledBg": "#f2f1ee",
        "disabledText": "#98a2b3",
