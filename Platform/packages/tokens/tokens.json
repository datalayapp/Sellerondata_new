        "nightLine": "#22355e",
        "onNight": "#ffffff",
        "onNight2": "#8f9cb8",
        "onNightAccent": "{--focus-on-dark}"
      },
      "bands": {
        "site": {
          "bg": "{--night}",
          "pressed": "#16284f",
          "on": "#ffffff",
          "on2": "#8f9cb8",
          "track": "#22355e",
          "trackOn": "#b5cbff"
        },
        "hub": {
          "bg": "{bands.hub.band}",
          "pressed": "{bands.hub.band2}",
          "on": "#ffffff",
          "on2": "{bands.hub.on}",
          "track": "#4a4f5a",
          "trackOn": "{bands.hub.accent}"
        },
        "deciship": {
          "bg": "{bands.deciship.band}",
          "pressed": "{bands.deciship.band2}",
          "on": "#ffffff",
          "on2": "{bands.deciship.on}",
          "track": "rgba(255,255,255,0.3)",
          "trackOn": "#ffffff"
        }
