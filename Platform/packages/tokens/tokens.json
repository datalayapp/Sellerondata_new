        "--border-soft": "#e9e6df",
        "--placeholder": "#98a2b3",
        "--primary-hover": "#1546b8",
        "--primary-active": "#123c9c",
        "--primary-on-dark": "#b5cbff",
        "--ink-line": "#22355e",
        "--ink-text-2": "#c9d3e8",
        "--warning": "#7a4100",
        "--warning-bg": "#fff1d6",
