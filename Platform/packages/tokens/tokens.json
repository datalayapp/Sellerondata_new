        "info": {
          "bg": "rgba(255,255,255,0.16)",
          "fg": "#ffffff"
        },
        "warn": {
          "bg": "#fdf0d5",
          "fg": "#5c3b00"
        },
        "danger": {
          "bg": "#fdecea",
          "fg": "#a8231a"
        }
      }
    },
    "hubAuth": {
      "$note": "Merkez giriş ekranları (.auth): pakette karşılığı olmayan yerel değerler, üretilen hub-web/src/styles/tokens.hub.css'e yazılır; eşit olanlar auth.css'te var() ile bağlı. Karar bekliyor (fark kataloğu).",
