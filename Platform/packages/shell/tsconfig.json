{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@sellerondata/contracts": ["../contracts/src/index.ts"],
      "@sellerondata/format": ["../format/src/index.ts"],
      "i18next": ["../../apps/hub-web/node_modules/i18next"],
      "react-i18next": ["../../apps/hub-web/node_modules/react-i18next"],
      "react": ["../../apps/hub-web/node_modules/@types/react"],
      "react/*": ["../../apps/hub-web/node_modules/@types/react/*"],
      "react-dom": ["../../apps/hub-web/node_modules/@types/react-dom"],
      "react-dom/*": ["../../apps/hub-web/node_modules/@types/react-dom/*"],
      "@tanstack/react-query": ["../../apps/hub-web/node_modules/@tanstack/react-query"],
      "react-router": ["../../apps/hub-web/node_modules/react-router/dist/production/index.d.ts"]
    }
  },
  "include": ["src", "test"]
}
