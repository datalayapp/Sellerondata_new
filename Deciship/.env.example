# Uygulama rolü. Migration ayrı rol ve ayrı adresle çalışır (MIGRATE_DATABASE_URL, sod_deciship_admin).
DATABASE_URL=postgresql://sod_deciship:sod_deciship_dev@localhost:5434/sellerondata
# Hesap servisinin açık anahtarları (jeton doğrulama). Üretimde zorunlu.
ACCOUNT_JWKS_URL=http://localhost:4100/api/account/.well-known/jwks.json
# Çerezli yazmada ve CORS'ta kabul edilen kökenler, virgülle. Üretimde zorunlu.
ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173
# İmzalı dosya bağlantısı anahtarı, uzun ve rastgele. Üretimde zorunlu, geliştirmede boş olabilir.
FILE_TOKEN_SECRET=
# Veri sıfırlama ucu. Üretimde true verilirse servis başlamaz.
ENABLE_DATA_RESET=false
# Veritabanı havuzu (süreç başına bağlantı), bağlantı bekleme ve sorgu üst süresi. Süre dolunca kullanıcı 503 görür.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=60000
# Firma başına aynı anda çalışan pahalı istek (Merkez, Pano, satır listesi, rapor) ve dışa aktarma. Aşılırsa 429.
HUB_CONCURRENCY_PER_ORG=6
HUB_EXPORT_CONCURRENCY_PER_ORG=2
# Firma başına aynı anda çalışan liste isteği (ölçüm, fatura). Geniş sınır: yalnız kaçağı keser.
READ_CONCURRENCY_PER_ORG=20
# Okumayan istemci: dışa aktarma bu süre ilerlemezse kesilir.
HUB_EXPORT_IDLE_MS=120000
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
VISION_URL=http://localhost:8001
STORAGE_DIR=./storage
PORT=4000
