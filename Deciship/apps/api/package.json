{
  "name": "@deciship/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:db": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:perf:db": "vitest run --config vitest.perf-db.config.ts --silent=false",
    "seed": "tsx src/bin/seed.ts",
    "seed:demo-disputes": "tsx src/bin/seedDemoDisputes.ts",
    "ai:usage": "tsx src/bin/aiUsage.ts usage",
    "ai:grant": "tsx src/bin/aiUsage.ts grant",
    "reminders:once": "tsx src/bin/reminders.ts",
    "storage:orphans": "tsx src/bin/storageOrphans.ts",
    "purge:preview": "tsx src/bin/purgePreview.ts",
    "test:cli": "node --test test/cli-entries.test.mjs",
    "db:migrate": "prisma migrate dev --create-only && node scripts/check-drift.mjs --migrations-only && prisma migrate deploy",
    "db:check-drift": "node scripts/check-drift.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@deciship/core": "file:../../packages/core",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sellerondata/auth-kit": "file:../../../Platform/packages/auth-kit",
    "@sellerondata/contracts": "file:../../../Platform/packages/contracts",
    "@sellerondata/format": "file:../../../Platform/packages/format",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.15",
    "jszip": "^3.10.2",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pdfmake": "^0.3.13",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true
  }
}
