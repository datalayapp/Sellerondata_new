{
  "name": "@deciship/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "node --test test/*.test.ts",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build:prod-gateway": "node scripts/prod-gateway.mjs --build",
    "test:e2e:prod": "npm run build:prod-gateway && playwright test -c playwright.prod.config.ts"
  },
  "dependencies": {
    "@deciship/core": "file:../../packages/core",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@sellerondata/contracts": "file:../../../Platform/packages/contracts",
    "@sellerondata/format": "file:../../../Platform/packages/format",
    "@sellerondata/shell": "file:../../../Platform/packages/shell",
    "@tanstack/react-query": "^5.105.0",
    "i18next": "^26.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "msw": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
