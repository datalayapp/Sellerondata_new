{
  "cli": { "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "development", "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8088" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_ENV": "preview", "EXPO_PUBLIC_API_URL": "https://app.sellerondata.com" }
    },
    "production": {
      "android": { "buildType": "apk" },
      "env": { "APP_ENV": "production", "EXPO_PUBLIC_API_URL": "https://app.sellerondata.com" }
    }
  }
}
