{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "modules/box-measure/android",
    "modules/box-measure/ios"
  ]
}
