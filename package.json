{
  "name": "sellerondata",
  "private": true,
  "description": "Tek depo kök betikleri. Workspaces yok: her paket kendi node_modules ve kilit dosyasıyla kurulur (Mesaj 10 kararı, 2.3).",
  "type": "module",
  "engines": { "node": ">=24.22.1 <25" },
  "scripts": {
    "check": "node scripts/repo-check.mjs",
    "typecheck": "node scripts/test.mjs typecheck",
    "lint": "node tools/lint/run.mjs",
    "format:check": "node tools/lint/run.mjs --prettier-check",
    "test:quick": "node scripts/test.mjs quick",
    "test": "node scripts/test.mjs check typecheck lint quick",
    "test:db": "node scripts/test.mjs db",
    "test:all": "node scripts/test.mjs check typecheck lint quick db extra perf",
    "test:e2e": "node scripts/test.mjs e2e",
    "test:changed": "node scripts/test-changed.mjs",
    "test:perf": "node scripts/test.mjs perf",
    "t": "node scripts/t.mjs",
    "products:gen": "node Platform/scripts/products-gen.mjs",
    "products:check": "node Platform/scripts/products-gen.mjs --check",
    "i18n:unused": "node Platform/scripts/unused-i18n.mjs",
    "parts":"node scripts/test.mjs --list",
    "install:all": "node scripts/install.mjs",
    "main:ready": "node scripts/main-ready.mjs",
    "ci:son": "node scripts/ci-son.mjs",
    "pg:baslat": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-yerel.ps1 baslat",
    "pg:durdur": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-yerel.ps1 durdur",
    "pg:durum": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-yerel.ps1 durum",
    "pg:yerel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-yerel.ps1",
    "coverage:core": "node scripts/coverage.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  }
}
