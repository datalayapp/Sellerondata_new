{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    // Ortak kabuk (`link:`) kaynağından derlenir; kendi klasöründe React ve i18next yok. İçindeki içe aktarmalar TagPress
    // web'in kopyalarına çözülür (çalışma zamanındaki karşılığı `platform-peers.ts`).
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "react-i18next": ["./node_modules/react-i18next"],
      "i18next": ["./node_modules/i18next"],
      "react-router": ["./node_modules/react-router/dist/production/index.d.ts"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "@sellerondata/contracts": ["./node_modules/@sellerondata/contracts"],
      "@sellerondata/format": ["./node_modules/@sellerondata/format"]
    }
  },
  "include": ["src", "vite.config.ts", "platform-peers.ts"]
}
